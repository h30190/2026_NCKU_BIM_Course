      <Button x:Name="ReviewStart" Content="開始審查" Click="review_click" IsEnabled="False" Style="{StaticResource ActionButton}"/>
      <Button x:Name="Resolve" Content="儲存解法" Click="resolve_click" IsEnabled="False" Style="{StaticResource PrimaryActionButton}"/>
      <Button x:Name="Verify" Content="確認已驗證" Click="verify_click" IsEnabled="False" Style="{StaticResource ActionButton}"/>
      <Button x:Name="Archive" Content="封存" Click="archive_click" IsEnabled="False" Style="{StaticResource ActionButton}"/>
      <Button x:Name="DeleteReviewCase" Content="刪除案例" Click="delete_current_case" IsEnabled="False" Style="{StaticResource DangerActionButton}" ToolTip="永久刪除此案例（SOLVE）及其解法、審查歷程與套用紀錄；無法復原。"/>
     </WrapPanel>
    </StackPanel></ScrollViewer></TabItem>

    <!-- 修改建議: Claude reads context; approved steps run through Revit MCP. -->
    <TabItem x:Name="SuggestTab" Header="修改建議"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,10">
     <TextBlock Text="建議來源" Style="{StaticResource FieldLabel}"/>
     <WrapPanel Margin="0,6,0,8">
      <RadioButton x:Name="SuggestCaseMode" Content="透過過去案例" GroupName="SuggestionMode" IsChecked="True" Click="suggest_mode_changed" Margin="0,0,20,4"/>
      <RadioButton x:Name="SuggestAiMode" Content="透過 AI 建議" GroupName="SuggestionMode" Click="suggest_mode_changed" Margin="0,0,0,4"/>
     </WrapPanel>
     <TextBlock x:Name="SuggestModeHint" Text="選取過去解法，依目前元素狀態轉換成修改步驟。" Style="{StaticResource Hint}"/>
     <TextBlock x:Name="SuggestProvider" Text="Claude" FontWeight="SemiBold" Margin="0,2,0,6"/>
     <TextBlock Text="兩種方式均透過 MCP 讀取元素及套用修改。可先產生建議並檢視步驟，或按「自動修正」直接規劃及套用。" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
     <TextBox x:Name="SuggestContext" Style="{StaticResource HideWhenEmpty}" MaxHeight="160" Margin="0,0,0,8"/>
     <TextBlock Text="修正只限基準元素及產生建議時的選取物；同一元素的其他問題須另外選取。" Style="{StaticResource Hint}"/>
     <TextBlock x:Name="SuggestScope" TextWrapping="Wrap" Foreground="#37546B" Margin="0,2,0,8"/>
     <StackPanel x:Name="SuggestCasesPanel">
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="⟳" Click="refresh_suggest_click" Style="{StaticResource IconButton}" ToolTip="重新讀取同類型的過去解法"/>
      <TextBlock Text="參考的過去解法" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </DockPanel>
     <TextBlock x:Name="SuggestSourceSummary" Text="開啟此頁時讀取同類型元件的過去解法。" Style="{StaticResource Hint}" Margin="0,2,0,4"/>
     <ListBox x:Name="SuggestSources" SelectionMode="Multiple" MaxHeight="190" BorderBrush="#DFE7ED"
              SelectionChanged="suggest_inputs_changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" ToolTip="點選以加入或移除參考解法。">
      <ListBox.Style><Style TargetType="ListBox"><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ListBox.Style>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E8EEF3" BorderThickness="0,0,0,1" Padding="4,6"><StackPanel>
       <TextBlock Text="{Binding title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding meta}" FontSize="11" Foreground="#607286"/>
       <TextBlock Text="{Binding excerpt}" FontSize="11" Foreground="#52677A" TextTrimming="CharacterEllipsis"/>
      </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     </StackPanel>
     <TextBlock Text="你的指示" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
     <TextBox x:Name="SuggestPrompt" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
              TextChanged="suggest_inputs_changed" ToolTip="描述要解決的問題、目標尺寸及限制；AI 建議必須填寫。"/>
     <WrapPanel>
      <Button x:Name="SuggestAutoFix" Content="自動修正" Click="suggest_auto_click" Style="{StaticResource PrimaryButton}" ToolTip="授權 Claude 為目前基準元素與相關問題產生步驟並直接透過 Revit MCP 套用。有未解決的必要問題時停止。"/>
      <Button x:Name="SuggestRun" Content="產生建議" Click="suggest_click" Style="{StaticResource PrimaryButton}" ToolTip="依選擇的來源讀取模型並提出修改步驟。"/>
      <Button x:Name="SuggestCancel" Content="停止" Click="suggest_cancel" IsEnabled="False" Style="{StaticResource ActionButton}"/>
     </WrapPanel>
     <TextBlock x:Name="SuggestStatus" Style="{StaticResource Hint}" Foreground="#37546B" Margin="0,2,0,4"/>
     <TextBox x:Name="SuggestSummary" Style="{StaticResource HideWhenEmpty}" MaxHeight="140"/>
     <ListBox x:Name="SuggestSteps" BorderBrush="#DFE7ED" MaxHeight="260" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
      <ListBox.Style><Style TargetType="ListBox"><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ListBox.Style>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E8EEF3" BorderThickness="0,0,0,1" Padding="4,6"><StackPanel>
       <DockPanel>
        <Button x:Name="ApplySuggestionStep" DockPanel.Dock="Right" Content="套用" Tag="{Binding}" Click="suggest_apply_step" IsEnabled="{Binding can_apply}"
                Style="{StaticResource ActionButton}" ToolTip="只透過 MCP 執行這一項建議，其他項目留待個別套用。"/>
        <TextBlock Text="{Binding state}" FontSize="11" Foreground="#37546B" VerticalAlignment="Center"/>
       </DockPanel>
       <TextBlock Text="{Binding caption}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding reason}" FontSize="11" Foreground="#52677A" TextWrapping="Wrap"/>
      </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Button x:Name="SuggestApply" Content="套用全部" Click="suggest_apply" IsEnabled="False" Style="{StaticResource PrimaryActionButton}"
             HorizontalAlignment="Left" Margin="0,6,0,0" ToolTip="確認後透過 Revit MCP 依序執行尚未完成的步驟；已套用的項目不會重複執行。"/>
     <TextBox x:Name="SuggestResults" Style="{StaticResource HideWhenEmpty}" MaxHeight="160" Margin="0,6,0,0"/>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
  </DockPanel>
  </ScrollViewer>
 </DockPanel>
</Page>
