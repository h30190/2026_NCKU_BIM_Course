<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F7FA" FontFamily="Microsoft JhengHei, Segoe UI" FontSize="13" Foreground="#16384A" MinWidth="340">
 <Page.Resources>
  <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#16384A"/><Setter Property="BorderBrush" Value="#C5D2DC"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,3,6,3"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#176A7A"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value=".8"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value=".45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#176A7A"/><Setter Property="BorderBrush" Value="#176A7A"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <!-- Lifecycle and batch actions appear only when they can be used. -->
  <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
   <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
   <Setter Property="Foreground" Value="#C0392B"/><Setter Property="BorderBrush" Value="#E3B3AD"/>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="4,0,0,0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="5,4"/><Setter Property="Margin" Value="0,2,0,8"/><Setter Property="BorderBrush" Value="#C5D2DC"/></Style>
  <Style x:Key="ReadOnlyText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
   <Setter Property="Background" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#DFE7ED"/>
  </Style>
  <Style x:Key="HideWhenEmpty" TargetType="TextBox" BasedOn="{StaticResource ReadOnlyText}">
   <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,2,6,6"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,3,14,3"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#607286"/><Setter Property="Margin" Value="0,2,0,0"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#607286"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="NavTab" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#52677A"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="GroupName" Value="nav"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="6,10,6,7">
     <ContentPresenter HorizontalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F0F5F8"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#176A7A"/><Setter Property="Foreground" Value="#16384A"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SubTab" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#37546B"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,6,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Bd" Background="#E8EEF3" CornerRadius="12" Padding="11,4"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DCE6EE"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="#176A7A"/><Setter Property="Foreground" Value="White"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="5,4"/></Style>
  <Style x:Key="CaseResultList" TargetType="ListBox">
   <Setter Property="MinHeight" Value="120"/><Setter Property="MaxHeight" Value="360"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
   <!-- Pixel scrolling: rows re-wrap reliably when the docked pane is resized. -->
   <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
   <Setter Property="BorderBrush" Value="#DFE7ED"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></Setter.Value></Setter>
   <Setter Property="ItemTemplate"><Setter.Value><DataTemplate>
    <Border BorderBrush="#E8EEF3" BorderThickness="0,0,0,1" Padding="6,8"><DockPanel>
     <Border DockPanel.Dock="Right" Background="{Binding status_back}" CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Top">
      <TextBlock Text="{Binding status_label}" Foreground="{Binding status_fore}" FontSize="11"/></Border>
     <StackPanel><TextBlock Text="{Binding title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding meta}" FontSize="11" Foreground="#607286" Margin="0,2,0,0"/></StackPanel>
    </DockPanel></Border>
   </DataTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid"><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserSortColumns" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E3EAF0"/><Setter Property="AlternatingRowBackground" Value="#F4F7FA"/><Setter Property="BorderBrush" Value="#D4E0E8"/></Style>
 </Page.Resources>
 <DockPanel>
  <!-- Navigation: three workflows; pages within a workflow are pills. -->
  <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D4E0E8" BorderThickness="0,0,0,1">
   <StackPanel>
    <UniformGrid Columns="3">
     <RadioButton x:Name="NavChecks" Content="模型檢查" Tag="checks" Click="feature_click" Style="{StaticResource NavTab}" IsChecked="True"/>
     <RadioButton x:Name="NavElements" Content="元素分析" Tag="elements" Click="feature_click" Style="{StaticResource NavTab}"/>
     <RadioButton x:Name="NavCases" Content="案例" Tag="cases" Click="feature_click" Style="{StaticResource NavTab}"/>
    </UniformGrid>
    <WrapPanel x:Name="ElementNav" Margin="10,8,10,8" Visibility="Collapsed">
     <RadioButton x:Name="SubSimilar" Content="相似元素" Tag="similar" GroupName="elements" Click="feature_click" Style="{StaticResource SubTab}"/>
     <RadioButton x:Name="SubCompare" Content="元素比較" Tag="compare" GroupName="elements" Click="feature_click" Style="{StaticResource SubTab}"/>
     <RadioButton x:Name="SubGraph" Content="關係圖" Tag="graph" GroupName="elements" Click="feature_click" Style="{StaticResource SubTab}"/>
    </WrapPanel>
    <WrapPanel x:Name="CaseNav" Margin="10,8,10,8" Visibility="Collapsed">
     <RadioButton x:Name="SubLibrary" Content="案例庫" Tag="library" GroupName="cases" Click="feature_click" Style="{StaticResource SubTab}"/>
     <RadioButton x:Name="SubRelated" Content="相關案例" Tag="related" GroupName="cases" Click="feature_click" Style="{StaticResource SubTab}"/>
     <RadioButton x:Name="SubIssue" Content="問題紀錄" Tag="issue" GroupName="cases" Click="feature_click" Style="{StaticResource SubTab}"/>
     <RadioButton x:Name="SubReview" Content="解法審查" Tag="review" GroupName="cases" Click="feature_click" Style="{StaticResource SubTab}"/>
     <RadioButton x:Name="SubSuggest" Content="修改建議" Tag="suggest" GroupName="cases" Click="feature_click" Style="{StaticResource SubTab}"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D4E0E8" BorderThickness="0,1,0,0" Padding="10,4">
   <StackPanel>
    <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,2"/>
    <DockPanel>
     <ToggleButton x:Name="SettingsToggle" DockPanel.Dock="Right" Content="⚙" ToolTip="連線設定" Padding="6,1" Margin="6,0,0,0" Background="White" BorderBrush="#C5D2DC" VerticalAlignment="Center"/>
     <CheckBox x:Name="AutoHighlight" DockPanel.Dock="Right" Content="點選即定位" IsChecked="True" Margin="6,0,0,0" ToolTip="點選結果時，自動在 Revit 選取並定位該元素。"/>
     <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#37546B" VerticalAlignment="Center" Margin="0,3"/>
    </DockPanel>
    <DockPanel Visibility="{Binding IsChecked, ElementName=SettingsToggle, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
     <TextBlock Text="服務位址" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,6"/>
     <TextBox x:Name="Backend" Text="http://127.0.0.1:8000"/>
    </DockPanel>
   </StackPanel>
  </Border>
  <ScrollViewer x:Name="WorkAreaScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch" CanContentScroll="False">
  <DockPanel x:Name="WorkArea" Margin="10,10,10,6">
   <!-- The pinned element shared by every element and case page. -->
   <Border x:Name="TargetCard" DockPanel.Dock="Top" Background="White" BorderBrush="#D4E0E8" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="選取" Click="read_click" Style="{StaticResource IconButton}" ToolTip="以 Revit 目前選取的元素作為基準；未選取時可在模型中點選。"/>
      <Button Content="定位" Click="navigate_click" Style="{StaticResource IconButton}" ToolTip="在 Revit 選取並定位基準元素。"/>
     </StackPanel>
     <TextBlock Text="◎" FontSize="16" Foreground="#176A7A" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="TargetName" Text="尚未選擇基準元素" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="TargetDetail" Text="在 Revit 選取元素後按「選取」" FontSize="11" Foreground="#607286" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <Border x:Name="CaseScopeCard" DockPanel.Dock="Top" Background="#EAF2F7" CornerRadius="6" Padding="10,4" Margin="0,0,0,8" Visibility="Collapsed">
    <DockPanel>
     <CheckBox x:Name="VerifiedOnly" DockPanel.Dock="Right" Content="只看已驗證" Margin="6,0,0,0" Checked="related_options_changed" Unchecked="related_options_changed"/>
     <TextBlock Text="同類型 · 問題" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#37546B" ToolTip="只顯示與基準元素同一類型的案例；選「所有」包含全部問題類型。"/>
     <TextBlock x:Name="CaseTypeLabel" Visibility="Collapsed"/>
     <ComboBox x:Name="CaseIssueType" DisplayMemberPath="label" SelectionChanged="related_options_changed" Margin="0,2"/>
    </DockPanel>
   </Border>
   <TabControl x:Name="Tabs" BorderBrush="#D4E0E8" SelectionChanged="tabs_changed">
    <TabControl.Template><ControlTemplate TargetType="TabControl"><Border Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border></ControlTemplate></TabControl.Template>

    <!-- 模型檢查: settings compact at the top, results fill the page. -->
    <TabItem x:Name="ChecksTab" Header="模型檢查" IsSelected="True"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <!-- Fill the visible height so results take the remaining space; scroll only when very short. -->
     <Border Padding="10" MinHeight="460" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
       <DockPanel>
        <Button x:Name="RunModelChecks" DockPanel.Dock="Right" Content="▶ 檢查" Click="run_checks_click" Style="{StaticResource PrimaryButton}" Margin="0,2,0,6" MinWidth="80"/>
        <ComboBox x:Name="CheckRangeMode" DisplayMemberPath="label" SelectionChanged="check_options_changed" ToolTip="檢查範圍"/>
       </DockPanel>
       <DockPanel ToolTip="要檢查哪些元件。選取中的元件：按「檢查」時 Revit 中選取的元件；沒有選取時用上方基準元素。">
        <TextBlock Text="來源" VerticalAlignment="Center" Margin="0,0,8,4" Foreground="#37546B"/>
        <ComboBox x:Name="CheckScope" DisplayMemberPath="label" SelectionChanged="check_options_changed" Margin="0,0,0,6"/>
       </DockPanel>
       <Button x:Name="CancelPlanChecks" Content="■ 停止（保留已完成結果）" Click="cancel_plan_checks" IsEnabled="False" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/>
       <WrapPanel x:Name="CheckRangePanel" Visibility="Collapsed">
        <Button Content="在 Revit 框選" Click="pick_check_range"/><Button Content="使用目前選取" Click="use_selected_check_range"/>
       </WrapPanel>
       <TextBlock x:Name="CheckRangeSummary" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
       <WrapPanel Margin="0,0,0,2">
        <CheckBox x:Name="CheckDuplicates" Content="重複" IsChecked="True" Checked="check_options_changed" Unchecked="check_options_changed" ToolTip="疑似重複元件：同類型、位置及外框在容差內一致。"/>
        <CheckBox x:Name="CheckOverlaps" Content="同類重疊" IsChecked="True" Checked="check_options_changed" Unchecked="check_options_changed" ToolTip="同類元件之間的實體重疊；貼面不算。"/>
        <CheckBox x:Name="CheckClashes" Content="碰撞" IsChecked="True" Checked="check_options_changed" Unchecked="check_options_changed" ToolTip="與其他類型／類別元件的實體碰撞。"/>
        <CheckBox x:Name="CheckMarks" Content="Mark" IsChecked="True" Checked="check_options_changed" Unchecked="check_options_changed" ToolTip="同類別內重複的 Mark 編號。"/>
        <CheckBox x:Name="CheckWarnings" Content="警告" IsChecked="True" Checked="check_options_changed" Unchecked="check_options_changed" ToolTip="Revit 現有警告中涉及範圍內元件者。"/>
       </WrapPanel>
       <Expander Header="進階設定" Foreground="#37546B" Margin="0,0,0,4">
        <StackPanel Margin="0,4,0,0">
         <StackPanel IsEnabled="{Binding IsChecked, ElementName=CheckClashes}">
          <TextBlock Text="碰撞對象" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="ClashTarget" DisplayMemberPath="label" SelectionChanged="check_options_changed"/>
          <WrapPanel>
           <CheckBox x:Name="ClashSkipJoined" Content="略過已接合" IsChecked="True" Checked="check_options_changed" Unchecked="check_options_changed" ToolTip="依 Revit 接合幾何狀態判斷；只接觸或有宿主關係不算已接合。"/>
           <CheckBox x:Name="ClashSkipCollinear" Content="略過同一直線" IsChecked="True" Checked="check_options_changed" Unchecked="check_options_changed" ToolTip="兩者都有直線定位路徑，且在三維空間共線（反方向亦可）。"/>
          </WrapPanel>
         </StackPanel>
         <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,6,0"><TextBlock Text="重複位置 mm" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CheckPositionTolerance" Text="1" TextChanged="check_options_changed"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,6,0"><TextBlock Text="重疊體積 mm³" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CheckVolumeTolerance" Text="0" TextChanged="check_options_changed"/></StackPanel>
          <StackPanel Grid.Column="2" IsEnabled="{Binding IsChecked, ElementName=CheckClashes}"><StackPanel IsEnabled="{Binding IsChecked, ElementName=ClashSkipCollinear}"><TextBlock Text="共線距離 mm" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ClashLineTolerance" Text="1" TextChanged="check_options_changed"/></StackPanel></StackPanel>
         </Grid>
         <CheckBox x:Name="AutoChecks" Content="模型或視圖變更後自動重查" IsChecked="True"/>
         <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="不含連結模型。Room、線元素及無實體元件不作碰撞判定。每張圖最多 150 個來源、500 組候選、約 5 秒；未完成的範圍不會視為通過。"/>
        </StackPanel>
       </Expander>
      </StackPanel>
      <StackPanel Grid.Row="1" Margin="0,4,0,4">
       <Border BorderBrush="#E3EAF0" BorderThickness="0,1,0,0" Margin="0,0,0,6"/>
       <DockPanel>
        <ComboBox x:Name="CheckFilter" DockPanel.Dock="Right" DisplayMemberPath="label" SelectionChanged="filter_checks" MinWidth="110" Margin="6,0,0,0" ToolTip="篩選結果"/>
        <TextBlock x:Name="CheckSummary" Text="選取基準元素後按「檢查」。" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
       </DockPanel>
       <Expander x:Name="CheckNotesPanel" Header="檢查說明" Foreground="#37546B" Visibility="Collapsed" Margin="0,4,0,0">
        <StackPanel Margin="0,4,0,0">
         <TextBlock x:Name="CheckNotes" Style="{StaticResource Hint}"/>
         <TextBox x:Name="PlanCoverage" Style="{StaticResource HideWhenEmpty}" MaxHeight="160" Margin="0,6,0,0"/>
        </StackPanel>
       </Expander>
      </StackPanel>
      <ListBox Grid.Row="2" x:Name="CheckResults" MinHeight="120" SelectionChanged="check_result_changed" MouseDoubleClick="record_check_issue" BorderBrush="#DFE7ED" ScrollViewer.CanContentScroll="False"
               ToolTip="雙擊結果即可記錄為問題。" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate>
        <Border BorderBrush="#E8EEF3" BorderThickness="0,0,0,1" Padding="0,6"><DockPanel>
         <Border Width="4" Background="{Binding accent}" CornerRadius="2" Margin="0,0,8,0"/>
         <TextBlock DockPanel.Dock="Right" Text="{Binding status_label}" Foreground="{Binding accent}" FontSize="11" FontWeight="SemiBold" Margin="8,0,2,0"/>
         <StackPanel>
          <TextBlock Text="{Binding kind}" FontSize="11" Foreground="#607286"/>
          <TextBlock Text="{Binding headline}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding note}" FontSize="11" Foreground="#52677A" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
        </DockPanel></Border>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="3" Margin="0,6,0,0">
       <TextBox x:Name="CheckDetails" Style="{StaticResource HideWhenEmpty}" MaxHeight="120"/>
       <WrapPanel>
        <Button x:Name="LocateCheck" Content="定位" Click="locate_check_click" IsEnabled="False" ToolTip="在 Revit 選取並定位結果元素；兩個元素時定位後者（右側）。"/>
        <Button x:Name="ShowCheckGraph" Content="關係圖" Click="show_check_graph" IsEnabled="False" ToolTip="在關係圖查看此結果。"/>
        <Button x:Name="RecordCheckIssue" Content="記錄為問題" Click="record_check_issue" IsEnabled="False" Style="{StaticResource PrimaryButton}" ToolTip="以此結果建立問題紀錄（也可雙擊結果）。"/>
       </WrapPanel>
      </StackPanel>
     </Grid></Border>
    </ScrollViewer></TabItem>

    <TabItem x:Name="SimilarTab" Header="相似元素"><DockPanel Margin="10">
     <StackPanel DockPanel.Dock="Top">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="Scope" Grid.Column="0" DisplayMemberPath="label" SelectionChanged="similarity_options_changed" ToolTip="搜尋範圍"/>
       <ComboBox x:Name="Threshold" Grid.Column="1" DisplayMemberPath="label" SelectionChanged="similarity_options_changed" ToolTip="最低相似度"/>
       <Button Grid.Column="2" Content="搜尋" Click="similar_click" Style="{StaticResource PrimaryButton}" Margin="0,2,0,6" MinWidth="64"/>
      </Grid>
      <TextBlock x:Name="MatchSummary" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
      <TextBox x:Name="MatchDetails" Style="{StaticResource HideWhenEmpty}" MaxHeight="120"/>
      <WrapPanel>
       <Button x:Name="LocateMatch" Content="定位" Click="locate_match" IsEnabled="False" ToolTip="在 Revit 定位選取的結果（也可雙擊）。"/>
       <Button x:Name="SelectMatches" Content="全部選取" Click="select_matches" IsEnabled="False" ToolTip="在 Revit 選取清單中的全部結果。"/>
       <Button x:Name="UseMatch" Content="設為基準" Click="use_match" IsEnabled="False"/>
       <Button x:Name="CompareMatch" Content="比較" Click="compare_match" IsEnabled="False" ToolTip="與基準元素並排比較。"/>
      </WrapPanel>
      <Expander Header="跨專案記錄" Foreground="#37546B" Margin="0,4,0,0"><StackPanel Margin="0,4,0,0">
       <TextBlock Style="{StaticResource Hint}" Text="記錄的元素可在「已記錄元素」範圍中跨專案搜尋。"/>
       <WrapPanel><Button Content="記錄基準元素" Click="record_target"/><Button Content="重新載入" Click="refresh_elements"/><Button Content="移除" Click="remove_click"/></WrapPanel>
       <ListBox x:Name="Elements" Height="90" DisplayMemberPath="label" SelectionChanged="recorded_changed"/>
      </StackPanel></Expander>
     </StackPanel>
     <ListBox x:Name="Matches" MinHeight="100" SelectionChanged="match_changed" PreviewMouseLeftButtonUp="result_clicked" MouseDoubleClick="locate_match" BorderBrush="#DFE7ED" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#E8EEF3" BorderThickness="0,0,0,1" Padding="4,7"><DockPanel>
       <TextBlock Text="{Binding score_label}" DockPanel.Dock="Right" Foreground="#176A7A" FontWeight="Bold" FontSize="16" Margin="8,0,0,0" VerticalAlignment="Center"/>
       <StackPanel>
        <TextBlock Text="{Binding title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding subtitle}" FontSize="11" Foreground="#607286" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding reason}" FontSize="11" Foreground="#436357" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
      </DockPanel></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel></TabItem>

    <TabItem x:Name="CompareTab" Header="元素比較"><DockPanel Margin="10">
     <StackPanel DockPanel.Dock="Top">
      <WrapPanel>
       <Button Content="從 Revit 選取兩個元素" Click="pick_compare" Style="{StaticResource PrimaryButton}"/>
       <Button Content="重新讀取" Click="refresh_comparison"/>
       <Button Content="A ⇄ B" Click="swap_comparison" ToolTip="交換 A／B"/>
      </WrapPanel>
      <Grid Margin="0,6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Grid.Column="0" Background="#E9F3FA" CornerRadius="5" Padding="8" Margin="0,0,4,0"><DockPanel>
        <Button DockPanel.Dock="Right" Content="定位" Tag="0" Click="locate_comparison" Style="{StaticResource IconButton}" VerticalAlignment="Top"/>
        <StackPanel><TextBlock Text="A" FontWeight="Bold" Foreground="#1F5F99"/><TextBlock x:Name="CompareA" Text="尚未選擇" TextWrapping="Wrap"/><TextBlock x:Name="CompareASource" Style="{StaticResource Hint}"/></StackPanel>
       </DockPanel></Border>
       <Border Grid.Column="1" Background="#F0ECFA" CornerRadius="5" Padding="8" Margin="4,0,0,0"><DockPanel>
        <Button DockPanel.Dock="Right" Content="定位" Tag="1" Click="locate_comparison" Style="{StaticResource IconButton}" VerticalAlignment="Top"/>
        <StackPanel><TextBlock Text="B" FontWeight="Bold" Foreground="#5B3FA3"/><TextBlock x:Name="CompareB" Text="尚未選擇" TextWrapping="Wrap"/><TextBlock x:Name="CompareBSource" Style="{StaticResource Hint}"/></StackPanel>
       </DockPanel></Border>
      </Grid>
      <DockPanel>
       <CheckBox x:Name="DifferencesOnly" DockPanel.Dock="Right" Content="只看差異" Margin="6,0,0,0" Checked="comparison_filter_changed" Unchecked="comparison_filter_changed"/>
       <TextBlock x:Name="ComparisonSummary" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock x:Name="ComparisonNotice" Style="{StaticResource Hint}" Margin="0,2,0,6"/>
     </StackPanel>
     <DataGrid x:Name="ComparisonRows">
      <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers>
       <DataTrigger Binding="{Binding status}" Value="不同"><Setter Property="Background" Value="#FFF0DC"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
       <DataTrigger Binding="{Binding status}" Value="資料不足"><Setter Property="Foreground" Value="#687888"/></DataTrigger>
      </Style.Triggers></Style></DataGrid.RowStyle>
      <DataGrid.Columns><DataGridTextColumn Header="項目" Binding="{Binding label}" Width="110" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="A" Binding="{Binding left}" Width="*" MinWidth="80" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="B" Binding="{Binding right}" Width="*" MinWidth="80" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="比較" Binding="{Binding status}" Width="64" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns>
     </DataGrid>
    </DockPanel></TabItem>

    <TabItem x:Name="GraphTab" Header="關係圖"><DockPanel Margin="8">
     <StackPanel DockPanel.Dock="Top">
      <DockPanel>
       <Button x:Name="OpenKnowledgeWindow" DockPanel.Dock="Right" Content="新視窗" Click="open_knowledge_window" Style="{StaticResource IconButton}" Margin="4,2,0,6" ToolTip="在可移動的新視窗開啟知識圖譜（顯示方向、交叉關係與案例）。"/>
       <ComboBox x:Name="RelationFilter" DisplayMemberPath="label" SelectionChanged="filter_changed" ToolTip="關係篩選" Margin="0,2,0,6"/>
      </DockPanel>
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="⟳" Click="graph_refresh_click" Style="{StaticResource IconButton}" ToolTip="立即更新"/>
        <Button Content="展開" Click="expand_groups" Style="{StaticResource IconButton}" ToolTip="展開全部分組"/>
        <Button Content="收合" Click="collapse_groups" Style="{StaticResource IconButton}" ToolTip="收合明細"/>
        <Button Content="全圖" Click="fit_click" Style="{StaticResource IconButton}" ToolTip="縮放以顯示全圖"/>
       </StackPanel>
       <WrapPanel VerticalAlignment="Center">
        <CheckBox x:Name="ShowSimilar" Content="同類元素" IsChecked="True" Checked="graph_options_changed" Unchecked="graph_options_changed" ToolTip="依「相似元素」的範圍與門檻，在圖中加入最多 12 個同類元素。"/>
        <CheckBox x:Name="SnapshotOnly" Content="已儲存快照" IsEnabled="False" Checked="graph_options_changed" Unchecked="graph_options_changed" ToolTip="改看已開啟案例儲存時的關係，不會被自動更新覆蓋。"/>
       </WrapPanel>
      </DockPanel>
      <TextBlock x:Name="GraphSummary" Text="讀取基準元素後自動產生關係圖。" Style="{StaticResource Hint}" Margin="0,4"/>
     </StackPanel>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="100"/><RowDefinition Height="5"/><RowDefinition Height="1.1*" MinHeight="150"/></Grid.RowDefinitions>
      <ScrollViewer Grid.Row="0" x:Name="GraphScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="graph_size_changed"><Canvas x:Name="GraphCanvas" Width="600" Height="250" Background="White" MouseWheel="zoom" MouseLeftButtonDown="pan_start" MouseMove="pan_move" MouseLeftButtonUp="pan_end"/></ScrollViewer>
      <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="#DFE7ED"/>
      <DockPanel Grid.Row="2" Margin="0,6,0,0">
       <DockPanel DockPanel.Dock="Top">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
         <Button x:Name="GraphNavigate" Content="定位" Click="graph_navigate" IsEnabled="False" Style="{StaticResource IconButton}" ToolTip="在 Revit 查看此節點。"/>
         <Button x:Name="CompareNode" Content="比較" Click="compare_node" IsEnabled="False" Style="{StaticResource IconButton}" ToolTip="與基準元素比較。"/>
        </StackPanel>
        <StackPanel><TextBlock x:Name="NodeTitle" Text="點選節點查看資訊" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="42"/>
         <TextBlock x:Name="NodeSubtitle" Style="{StaticResource Hint}"/>
        </StackPanel>
       </DockPanel>
       <TabControl x:Name="GraphInspector" Margin="0,4,0,0">
        <TabItem Header="資訊"><DataGrid x:Name="NodeProperties"><DataGrid.Columns>
         <DataGridTextColumn Header="項目" Binding="{Binding label}" Width="120" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="內容" Binding="{Binding value}" Width="*" ElementStyle="{StaticResource CellText}"/>
        </DataGrid.Columns></DataGrid></TabItem>
        <TabItem Header="關係"><DataGrid x:Name="NodeRelations"><DataGrid.Columns>
         <DataGridTextColumn Header="關係" Binding="{Binding label}" Width="110" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="相關元素與說明" Binding="{Binding value}" Width="*" ElementStyle="{StaticResource CellText}"/>
        </DataGrid.Columns></DataGrid></TabItem>
        <TabItem x:Name="RulesTab" Header="相交規則"><DockPanel>
         <Button DockPanel.Dock="Bottom" x:Name="LocateRulePair" Content="定位這組元素" Click="locate_rule_pair" IsEnabled="False" HorizontalAlignment="Left" Margin="8,4"/>
         <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
          <Expander x:Name="RuleEditor" Header="新增／更新規則（以基準元素為來源）" IsExpanded="True" Foreground="#37546B">
           <StackPanel Margin="0,4">
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
             <StackPanel Grid.Column="0"><TextBlock Text="適用元素" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RuleSourceScope" DisplayMemberPath="label"/></StackPanel>
             <StackPanel Grid.Column="1"><TextBlock Text="不可相交的類別" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RuleTargetCategory" DisplayMemberPath="label"/></StackPanel>
            </Grid>
            <TextBlock Text="交集體積容差 mm³（0 = 不容許重疊；貼面不算）" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="RuleTolerance" Text="0" Width="120" HorizontalAlignment="Left"/>
            <CheckBox x:Name="RuleExcludeHost" Content="允許與宿主相交（例如門與宿主牆）" IsChecked="False"/>
            <Button x:Name="SaveGeometryRule" Content="加入／更新規則" Click="save_geometry_rule" HorizontalAlignment="Left"/>
           </StackPanel>
          </Expander>
          <TextBlock Text="專案規則" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
          <ComboBox x:Name="GeometryRules" SelectionChanged="geometry_rule_changed"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding label}" TextWrapping="Wrap" MaxWidth="500"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <WrapPanel>
           <Button x:Name="RunGeometryRules" Content="▶ 檢查目前視圖" Click="check_geometry_click" IsEnabled="False" Style="{StaticResource PrimaryButton}"/>
           <Button x:Name="RemoveGeometryRule" Content="移除規則" Click="remove_geometry_rule" IsEnabled="False"/>
          </WrapPanel>
          <CheckBox x:Name="AutoRuleCheck" Content="模型或視圖變更後自動重查" IsChecked="False"/>
          <TextBlock x:Name="RuleSummary" TextWrapping="Wrap" Foreground="#37546B" Margin="0,4"
                     ToolTip="只檢查目前視圖內的本機模型元件，不含連結模型。最多 150 個來源、500 組候選、約 5 秒；未完成或無實體幾何會標示未能確認。"/>
          <ListBox x:Name="RuleResults" Height="140" SelectionChanged="rule_result_changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding label}" TextWrapping="Wrap" Margin="4,6"/></DataTemplate></ListBox.ItemTemplate></ListBox>
          <TextBox x:Name="RuleResultDetails" Style="{StaticResource HideWhenEmpty}" MaxHeight="80"/>
         </StackPanel></ScrollViewer>
        </DockPanel></TabItem>
       </TabControl>
      </DockPanel>
     </Grid>
    </DockPanel></TabItem>

    <TabItem x:Name="LibraryTab" Header="案例庫"><Grid Margin="10">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0">
      <DockPanel>
       <Button DockPanel.Dock="Right" Content="⟳" Click="refresh_cases" Style="{StaticResource IconButton}" Margin="6,2,0,8" ToolTip="重新載入案例"/>
       <Grid>
        <TextBox x:Name="CaseQuery" TextChanged="filter_cases" Background="Transparent" ToolTip="搜尋標題、內容、解法或 RFI 編號"/>
        <TextBlock Text="搜尋標題、內容、解法或 RFI 編號" Foreground="#9AA9B6" Margin="8,6,0,0" IsHitTestVisible="False">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
          <DataTrigger Binding="{Binding Text, ElementName=CaseQuery}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
         </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </Grid>
      </DockPanel>
      <TextBlock x:Name="LibrarySummary" Text="正在載入案例…" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
     </StackPanel>
     <ListBox Grid.Row="1" x:Name="Cases" Style="{StaticResource CaseResultList}" SelectionChanged="library_changed" MouseLeftButtonUp="library_clicked"/>
     <StackPanel Grid.Row="2" Margin="0,8,0,0">
      <TextBox x:Name="LibraryDetails" Style="{StaticResource ReadOnlyText}" Height="120"/>
      <WrapPanel>
       <Button x:Name="LocateLibraryCase" Content="定位" Click="locate_library_case" IsEnabled="False" ToolTip="在 Revit 定位案例元件。"/>
       <Button x:Name="OpenLibraryCase" Content="開啟紀錄" Click="open_click" IsEnabled="False" ToolTip="在「問題紀錄」開啟此案例。"/>
       <Button x:Name="OpenLibrarySolution" Content="查看解法" Click="open_library_solution" IsEnabled="False" Style="{StaticResource PrimaryButton}" ToolTip="在「解法審查」開啟此案例。"/>
       <Button x:Name="DeleteLibraryCase" Content="刪除" Click="delete_library_case" IsEnabled="False" Style="{StaticResource DangerActionButton}" ToolTip="永久刪除此案例或問題，包括解法、審查歷程與套用紀錄；無法復原。"/>
      </WrapPanel>
     </StackPanel>
    </Grid></TabItem>

    <TabItem x:Name="HistoryTab" Header="相關案例"><Grid Margin="10">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="0,0,0,6">
      <Button DockPanel.Dock="Right" Content="⟳" Click="search_click" Style="{StaticResource IconButton}" ToolTip="立即更新相關案例"/>
      <TextBlock x:Name="CaseSummary" Text="與基準元素同類型的過往案例。" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
     </DockPanel>
     <ListBox Grid.Row="1" x:Name="RelatedCases" Style="{StaticResource CaseResultList}" SelectionChanged="case_changed" PreviewMouseLeftButtonUp="result_clicked"/>
     <StackPanel Grid.Row="2" Margin="0,8,0,0">
      <TextBox x:Name="CaseDetails" Style="{StaticResource ReadOnlyText}" Height="130"/>
      <WrapPanel><Button Content="開啟案例" Click="open_related" Style="{StaticResource PrimaryButton}"/><Button Content="定位" Click="locate_case" ToolTip="在 Revit 定位案例元件。"/></WrapPanel>
     </StackPanel>
    </Grid></TabItem>

    <TabItem x:Name="IssueTab" Header="問題紀錄"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,10">
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="＋ 新問題" Click="new_click" Style="{StaticResource IconButton}" ToolTip="清空表單，建立另一個問題。"/>
      <TextBlock x:Name="CaseState" Text="新問題 · 尚未儲存" FontWeight="Bold" VerticalAlignment="Center"/>
     </DockPanel>
     <TextBlock x:Name="IssueOrigin" Style="{StaticResource Hint}" Foreground="#37546B" Margin="0,4,0,0" Visibility="Collapsed"/>
     <TextBlock Text="標題" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/><TextBox x:Name="IssueTitle"/>
     <TextBlock Text="描述" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Description" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0"><TextBlock Text="問題類型" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="IssueType" DisplayMemberPath="label" SelectionChanged="issue_options_changed"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="優先程度" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Priority" DisplayMemberPath="label" Margin="0,2,0,6"/></StackPanel>
     </Grid>
     <Expander Header="備註與擷取設定" Foreground="#37546B" Margin="0,2,0,6"><StackPanel Margin="0,4,0,0">
      <TextBlock Text="備註" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Notes" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
      <CheckBox x:Name="IncludeRelated" Content="加入同文件的已記錄元素" Checked="graph_options_changed" Unchecked="graph_options_changed"/>
      <CheckBox x:Name="Deep" Content="深入擷取（2 層關係）" Checked="graph_options_changed" Unchecked="graph_options_changed"/>
     </StackPanel></Expander>
     <WrapPanel>
      <Button Content="儲存草稿" Click="save_click" Style="{StaticResource PrimaryButton}" ToolTip="儲存表單並擷取基準元素的局部關係。"/>
      <Button x:Name="Submit" Content="提交" Click="submit_click" Style="{StaticResource ActionButton}" ToolTip="儲存並提交；提交後即可分析及審查解法。"/>
      <Button x:Name="Analyze" Content="分析" Click="analyze_click" IsEnabled="False" Style="{StaticResource ActionButton}" ToolTip="以已驗證案例分析此問題；結果需人工審查。"/>
      <Button x:Name="DeleteIssue" Content="刪除問題" Click="delete_current_case" IsEnabled="False" Style="{StaticResource DangerActionButton}" ToolTip="永久刪除目前開啟的問題及其所有紀錄；無法復原。"/>
     </WrapPanel>
     <TextBox x:Name="Results" Style="{StaticResource HideWhenEmpty}" Height="120" Margin="0,6,0,0"/>
    </StackPanel></ScrollViewer></TabItem>

    <TabItem x:Name="ReviewTab" Header="解法審查"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,10">
     <TextBlock x:Name="ReviewCaseState" Foreground="#176A7A" FontWeight="Bold"/>
     <TextBlock x:Name="ReviewCaseTitle" Text="尚未開啟案例" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,6"/>
     <TextBox x:Name="ReviewDescription" Style="{StaticResource HideWhenEmpty}" Height="90"/>
     <Border Background="#F4F7FA" BorderBrush="#DFE7ED" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,2,0,6">
      <StackPanel>
       <DockPanel>
        <Button DockPanel.Dock="Right" Content="⟳ 偵測" Click="detect_changes_click" Style="{StaticResource IconButton}"
                ToolTip="比對案例快照與目前模型；以 Revit UniqueId 或 IFC GlobalId 對應已記錄元件。"/>
        <TextBlock Text="模型變更" FontWeight="SemiBold" VerticalAlignment="Center"/>
       </DockPanel>
       <TextBlock x:Name="ChangeSummary" Text="開啟案例後自動比對已記錄元件。" Style="{StaticResource Hint}" Margin="0,2,0,4"/>
       <ListBox x:Name="ChangeResults" MaxHeight="230" SelectionChanged="change_selected" BorderBrush="#DFE7ED"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
        <ListBox.Style><Style TargetType="ListBox"><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ListBox.Style>
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate>
         <Border BorderBrush="#E8EEF3" BorderThickness="0,0,0,1" Padding="0,5"><DockPanel>
          <Border Width="4" Background="{Binding accent}" CornerRadius="2" Margin="0,0,8,0"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding status_label}" Foreground="{Binding accent}" FontSize="11" FontWeight="SemiBold" Margin="8,0,2,0"/>
          <StackPanel>
           <TextBlock Text="{Binding title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
           <TextBlock Text="{Binding detail}" FontSize="11" Foreground="#52677A" TextWrapping="Wrap"/>
          </StackPanel>
         </DockPanel></Border>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <Button x:Name="UseChanges" Content="加入解法" Click="append_changes_click" IsEnabled="False" Style="{StaticResource ActionButton}"
               HorizontalAlignment="Left" Margin="0,6,0,0" ToolTip="把變更紀錄加到下方解決方案。"/>
      </StackPanel>
     </Border>
     <TextBlock Text="解決方案" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
     <TextBox x:Name="Solution" Height="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
     <TextBlock Text="審核者（驗證時必填）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Reviewer"/>
     <TextBlock x:Name="ReviewHint" Text="從「案例庫」開啟案例後，可在此審查解法。" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
