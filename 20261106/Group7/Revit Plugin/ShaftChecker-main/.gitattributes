# 統一換行字元，避免 Windows／Mac 組員之間每一行都被當成「有修改」
* text=auto

# Windows 批次檔與 Visual Studio 方案檔必須是 CRLF，否則中文訊息與 chcp 會出錯
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf

*.cs   text diff=csharp
*.csproj text
*.json text
*.html text
*.md   text
*.py   text diff=python

# 二進位檔
*.png binary
*.jpg binary
*.rvt binary
*.rfa binary
