<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="案例驅動 BIM 診斷與修正 · 知識圖譜" Width="1360" Height="860" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner"
 Background="#F3F6FA" FontFamily="Microsoft JhengHei UI, Segoe UI" FontSize="13" Closed="window_closed" Loaded="window_loaded">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,6,6"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#203D53"/><Setter Property="BorderBrush" Value="#C9D7E3"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E8EEF3"/><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeaderWidth" Value="0"/></Style>
  <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="5,6"/></Style>
  <Style x:Key="NodeCard" TargetType="Button">
   <Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="CardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#F59E0B"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#F59E0B"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top">
   <DockPanel><StackPanel><TextBlock Text="知識圖譜" FontSize="24" FontWeight="SemiBold" Foreground="#17364D"/><TextBlock Text="KNOWLEDGE GRAPH · 模型、分類與案例關係" Foreground="#587084" FontSize="12" Margin="0,4,0,12"/></StackPanel><TextBlock x:Name="SourceLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#587084" MaxWidth="460" TextWrapping="Wrap"/></DockPanel>
   <WrapPanel>
    <Button Content="讀取 Revit 選取元素" Click="read_target" Background="#19697A" Foreground="White"/>
    <Button Content="立即更新" Click="refresh_click"/><Button Content="顯示全圖" Click="fit_click"/><Button Content="100%" Click="actual_size"/>
    <Button Content="−" Click="zoom_out" ToolTip="縮小"/><Button Content="＋" Click="zoom_in" ToolTip="放大"/>
    <TextBlock x:Name="ZoomLabel" Text="100%" Width="55" VerticalAlignment="Center" Margin="2,0,4,6"/>
    <ComboBox x:Name="RelationFilter" Width="180" DisplayMemberPath="label" SelectionChanged="filter_changed" Margin="0,0,12,6" Padding="6"/>
    <CheckBox x:Name="AutoHighlight" Content="點選元素／案例自動高亮" VerticalAlignment="Center" Margin="0,0,10,6"/>
    <CheckBox x:Name="VerifiedCases" Content="只看已驗證案例" VerticalAlignment="Center" Margin="0,0,10,6"/>
   </WrapPanel>
   <WrapPanel Margin="0,3,0,5"><TextBlock Text="案例分類：同元件類型 · 問題類型" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#203D53"/>
    <ComboBox x:Name="CaseIssueType" Width="175" DisplayMemberPath="label" Padding="5" Margin="0,0,12,0"/>
    <TextBlock x:Name="CaseTypeLabel" MaxWidth="580" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#587084"/>
   </WrapPanel>
   <TextBlock x:Name="Summary" Foreground="#587084" TextWrapping="Wrap" Margin="0,2,0,10"/>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" Padding="0,10,0,0"><TextBlock x:Name="Status" Text="滾輪縮放 · 拖曳空白處平移 · 點選節點查看資訊" Foreground="#587084" TextWrapping="Wrap"/></Border>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="390"/><ColumnDefinition Width="8"/><ColumnDefinition Width="340" MinWidth="260"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" BorderBrush="#D9E3EB" BorderThickness="1" CornerRadius="8">
    <DockPanel>
     <Border DockPanel.Dock="Top" BorderBrush="#E8EEF3" BorderThickness="0,0,0,1" Padding="12,10"><StackPanel>
      <WrapPanel><TextBlock Text="● 基準／元素   " Foreground="#246888"/><TextBlock Text="● 分類   " Foreground="#7464A6"/><TextBlock Text="● 案例／解法   " Foreground="#A66B20"/><TextBlock Text="● 檢查結果" Foreground="#B74242"/></WrapPanel>
      <TextBlock Text="實線：模型或案例記錄　虛線：比較分類／參考案例元素" FontSize="11" Foreground="#6D7F8F" Margin="0,4,0,0"/>
     </StackPanel></Border>
     <Grid>
      <ScrollViewer x:Name="GraphScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="wheel" PreviewMouseLeftButtonDown="pan_start" PreviewMouseMove="pan_move" PreviewMouseLeftButtonUp="pan_end" LostMouseCapture="pan_lost">
       <Canvas x:Name="GraphCanvas" Width="600" Height="400" Background="White"/>
      </ScrollViewer>
      <TextBlock x:Name="EmptyMessage" Text="先在 Revit 選取一個元素，再按「讀取 Revit 選取元素」。" Foreground="#587084" TextWrapping="Wrap" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
     </Grid>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>
   <Border Grid.Column="2" Background="White" BorderBrush="#D9E3EB" BorderThickness="1" CornerRadius="8" Padding="12">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="節點資訊" FontSize="11" Foreground="#6D7F8F"/>
      <TextBlock x:Name="NodeTitle" Text="點選圖中節點" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" Foreground="#203D53" Margin="0,6"/>
      <TextBlock x:Name="NodeSubtitle" Foreground="#6D7F8F" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <Button x:Name="LocateNode" Content="在 Revit 查看此元素" Click="locate_click" IsEnabled="False"/>
      <WrapPanel><Button x:Name="OpenCase" Content="開啟案例" Click="open_case_click" IsEnabled="False"/><Button x:Name="OpenSolution" Content="開啟解法" Click="open_solution_click" IsEnabled="False"/></WrapPanel>
     </StackPanel>
     <TabControl>
      <TabItem Header="節點內容"><DataGrid x:Name="NodeProperties"><DataGrid.Columns><DataGridTextColumn Header="項目" Binding="{Binding label}" Width="100" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="內容" Binding="{Binding value}" Width="*" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid></TabItem>
      <TabItem Header="關係與依據"><DataGrid x:Name="NodeRelations"><DataGrid.Columns><DataGridTextColumn Header="關係" Binding="{Binding label}" Width="95" ElementStyle="{StaticResource CellText}"/><DataGridTextColumn Header="相關資訊" Binding="{Binding value}" Width="*" ElementStyle="{StaticResource CellText}"/></DataGrid.Columns></DataGrid></TabItem>
     </TabControl>
    </DockPanel>
   </Border>
  </Grid>
 </DockPanel>
</Window>
