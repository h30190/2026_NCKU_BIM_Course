<Window x:Class="LebrCarbon.UI.EstimateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LEBR 結構碳排估算" Width="860" Height="800"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Microsoft JhengHei UI" FontSize="13" Background="#F6F5F2">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="18">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button x:Name="RereadButton" DockPanel.Dock="Left" Content="重新讀取模型" Style="{StaticResource Secondary}" Click="OnReread"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource Secondary}" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" Content="計算並儲存" Style="{StaticResource Primary}" IsEnabled="False" Click="OnSave"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="ModelText" Style="{StaticResource Sub}" Margin="0,0,0,10"/>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1. 品類對應（每項選擇附錄一 P-LCC 材料）" Style="{StaticResource SectionTitle}"/>
                        <Grid x:Name="SourceHeader" Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="模型品類" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="模型量" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="對應材料（附錄一）" FontWeight="SemiBold"/>
                        </Grid>
                        <StackPanel x:Name="SourcePanel"/>
                        <TextBlock x:Name="SourceNote" Style="{StaticResource Sub}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="2. 計算結果（CFsn = An × L + Bn × M）" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,4,0,8">
                            <Run FontWeight="SemiBold">參數說明</Run><LineBreak/>
                            <Run FontWeight="SemiBold">An</Run>：混凝土數量（m³），單位依附錄一所選材料<LineBreak/>
                            <Run FontWeight="SemiBold">L</Run>：混凝土單位碳排係數（kgCO2e／m³），取附錄一「總碳排量」欄<LineBreak/>
                            <Run FontWeight="SemiBold">Bn</Run>：鋼筋數量（kg），由模型鋼筋體積 × 7850 kg/m³ 換算<LineBreak/>
                            <Run FontWeight="SemiBold">M</Run>：鋼筋單位碳排係數（kgCO2e／kg），取附錄一「總碳排量」欄<LineBreak/>
                            <Run FontWeight="SemiBold">CFsn</Run>：第 n 層結構碳排量（kgCO2e）= An × L + Bn × M<LineBreak/>
                            <Run FontWeight="SemiBold">地上／地下</Run>：標高 ≥ 0 為地上，標高 &lt; 0 為地下；兩者各自加總後合計為 CFs
                        </TextBlock>
                        <DataGrid x:Name="LevelGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,4,0,8" MinHeight="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="樓層" Binding="{Binding Level}" Width="*"/>
                                <DataGridTextColumn Header="標高 (m)" Binding="{Binding Elevation}" Width="80"/>
                                <DataGridTextColumn Header="地上／地下" Binding="{Binding Zone}" Width="80"/>
                                <DataGridTextColumn Header="混凝土 (m³)" Binding="{Binding Concrete}" Width="100"/>
                                <DataGridTextColumn Header="鋼筋 (kg)" Binding="{Binding Rebar}" Width="100"/>
                                <DataGridTextColumn Header="CFsn (kgCO2e)" Binding="{Binding Cfs}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="TotalText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="NotesText" Foreground="{StaticResource ErrorInk}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Button x:Name="CalculateButton" Content="計算" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Click="OnCalculate"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
