  "language": "zh-TW",
  "agent_scope": {
    "scope_statement": "本次 PoC Agent 只處理商辦標準層的自然通風開窗配置、法定有效通風面積初判、EEWH 自然通風 VP 評分及簡化風量排序；不處理採光、外殼節能、消防排煙或施工圖核定。",
    "active_rule_ids": [
      "TW-WIND-LAW-001",
      "TW-WIND-ASSUMPTION-001",
      "TW-WIND-EEWH-001",
      "TW-WIND-REC-001"
    ],
    "conditional_reference_rule_ids": ["TW-WIND-LAW-002"],
    "inactive_rule_ids": ["TW-WIND-LAW-003", "TW-WIND-LAW-004", "TW-WIND-EEWH-002"],
    "inactive_reason": "本輪 Agent 不設計自然通風管道、不判定無窗戶居室消防效果，也不執行 ENVLOAD 能源優惠；規則保留供後續擴充。"
  },
  "units": {
