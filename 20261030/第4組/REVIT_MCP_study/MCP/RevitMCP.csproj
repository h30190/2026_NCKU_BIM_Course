<Project Sdk="Nice3point.Revit.Sdk/6.1.0">

  <PropertyGroup>
    <RootNamespace>RevitMCP</RootNamespace>
    <AssemblyName>RevitMCP</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <!-- DeployAddin 關閉：避免 SDK 自動產生 RevitMCP.{version}.addin 造成重複載入 -->
    <!-- 部署請使用 setup.ps1 或 /deploy-addon skill -->
    <DeployAddin>false</DeployAddin>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Configurations>
      Debug.R22;Debug.R23;Debug.R24;Debug.R25;Debug.R26;
      Release.R22;Release.R23;Release.R24;Release.R25;Release.R26
    </Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- 鎖定 Revit API DLL 為 Copy Local = False（不複製到本機輸出目錄，避免與 Revit 宿主衝突） -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <Reference Update="RevitAPI;RevitAPIUI">
      <Private>False</Private>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="ClosedXML" Version="0.102.3" />
  </ItemGroup>

</Project>
