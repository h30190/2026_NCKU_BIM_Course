<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>TemporalBim</AssemblyName>
    <RootNamespace>TemporalBim</RootNamespace>
    <!-- Revit 外掛必須是 x64 -->
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- 多版本：dotnet build -c Release.R24（教室機器，有裝 Revit 2024）-->
    <Configurations>Debug;Release;Release.R24;Release.R26</Configurations>
    <RevitVersion>2024</RevitVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release.R24'">
    <RevitVersion>2024</RevitVersion>
    <OutputPath>bin\Release.R24\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release.R26'">
    <RevitVersion>2026</RevitVersion>
    <OutputPath>bin\Release.R26\</OutputPath>
  </PropertyGroup>

  <!-- RevitAPI 從本機對應版本安裝目錄引用；有裝該版 Revit 才能 build 該配置。 -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- Diff 結果是巢狀 JSON（changedFields 是陣列中的陣列），骨架的正規表達式解析法
       只能處理單層物件，這裡改用 Newtonsoft.Json 正常解析，比較不容易出 bug。 -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
